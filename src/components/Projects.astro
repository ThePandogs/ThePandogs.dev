---
import { Image } from "astro:assets"
import Icon from "./Icon.astro"
import { projects } from "@/data/profile"
import { type Lang, useTranslations } from "@/i18n"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)

const featured = projects.filter((p) => p.image)
const others = projects.filter((p) => !p.image)
---

<div class="grid gap-6 sm:grid-cols-2">
  {
    featured.map((project) => (
      <article
        class:list={[
          "group overflow-hidden rounded-2xl border border-line bg-surface transition hover:border-fg/25",
          project.wide && "sm:col-span-2",
        ]}
      >
        <a
          href={project.site ?? project.repo}
          target="_blank"
          rel="noopener noreferrer"
          class:list={[
            "relative block overflow-hidden border-b border-line bg-bg",
            project.wide ? "aspect-[16/10] sm:aspect-[21/9]" : "aspect-[16/10]",
          ]}
          aria-label={t(project.site ? "projects.open" : "projects.code", { title: project.title })}
        >
          {project.image && (
            <Image
              src={project.image}
              alt={t("projects.screenshotAlt", { title: project.title })}
              widths={project.wide ? [640, 1024, 1440] : [480, 800]}
              sizes={project.wide ? "(min-width: 1024px) 760px, 100vw" : "(min-width: 640px) 50vw, 100vw"}
              class="size-full object-cover object-top transition duration-500 group-hover:scale-[1.03]"
            />
          )}
        </a>
        <div class="p-5">
          <div class="flex items-start justify-between gap-4">
            <h3 class="text-lg font-medium">{project.title}</h3>
            <Icon
              name="arrow"
              class="mt-1 size-4 shrink-0 text-muted transition group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent"
            />
          </div>
          <p class="mt-2 text-sm leading-relaxed text-muted text-pretty">{project.description[lang]}</p>
          <ul class="mt-4 flex flex-wrap gap-2">
            {project.tags.map((tag) => (
              <li class="rounded-md bg-bg px-2 py-0.5 font-mono text-xs text-muted">{tag}</li>
            ))}
          </ul>
        </div>
      </article>
    ))
  }
</div>

{
  others.length > 0 && (
    <ul class="mt-6 divide-y divide-line rounded-2xl border border-line">
      {others.map((project) => {
        const href = project.private ? undefined : (project.site ?? project.repo)
        const Tag = href ? "a" : "div"
        return (
          <li>
            <Tag
              href={href}
              target={href && "_blank"}
              rel={href && "noopener noreferrer"}
              class:list={["group block p-5 transition", href && "hover:bg-surface"]}
            >
              <div class="flex flex-wrap items-center gap-2">
                <h3 class="font-medium">{project.title}</h3>
                {project.status && (
                  <span class="rounded-md bg-accent/15 px-2 py-0.5 font-mono text-[0.7rem] text-accent">
                    {project.status[lang]}
                  </span>
                )}
                {project.private && (
                  <span class="flex items-center gap-1 font-mono text-[0.7rem] text-muted">
                    <Icon name="lock" class="size-3" />
                    {t("projects.private")}
                  </span>
                )}
                {href && (
                  <Icon name="arrow" class="ml-auto size-4 text-muted transition group-hover:text-accent" />
                )}
              </div>
              <p class="mt-2 text-sm leading-relaxed text-muted text-pretty">{project.description[lang]}</p>
              <p class="mt-3 font-mono text-xs text-muted">{project.tags.join(" · ")}</p>
            </Tag>
          </li>
        )
      })}
    </ul>
  )
}

