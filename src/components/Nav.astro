---
import Icon from "./Icon.astro"
import { profile } from "@/data/profile"
import { type Lang, homePath, useTranslations } from "@/i18n"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
const otherLang: Lang = lang === "es" ? "en" : "es"

const items = [
  { href: "#experiencia", label: t("nav.experience") },
  { href: "#webs", label: t("nav.clients") },
  { href: "#proyectos", label: t("nav.projects") },
  { href: "#sobre-mi", label: t("nav.about") },
  { href: "#contacto", label: t("nav.contact") },
]
---

<header class="fixed inset-x-0 top-0 z-50 px-4 pt-[calc(1rem+env(safe-area-inset-top,0px))]">
  <nav
    class="relative mx-auto flex max-w-5xl items-center justify-between rounded-2xl border border-line/80 bg-bg/70 px-4 py-2.5 backdrop-blur-xl"
    aria-label={t("nav.label")}
  >
    <a href={homePath(lang)} class="font-mono text-sm font-medium tracking-tight">
      {profile.alias.toLowerCase()}<span class="text-accent">.</span>
    </a>

    <div class="flex items-center gap-1">
      <ul class="hidden items-center gap-1 md:flex">
        {
          items.map((item) => (
            <li>
              <a
                href={item.href}
                data-nav={item.href.slice(1)}
                class="rounded-lg px-3 py-1.5 text-sm text-muted transition hover:text-fg data-[active]:text-fg"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a
        href={homePath(otherLang)}
        hreflang={otherLang}
        lang={otherLang}
        class="ml-1 grid h-9 place-items-center rounded-lg px-2.5 font-mono text-xs uppercase text-muted transition hover:bg-surface hover:text-fg"
        aria-label={t("nav.language")}
        title={t("nav.language")}
      >
        {otherLang}
      </a>
      <button
        id="theme-toggle"
        type="button"
        class="grid size-9 place-items-center rounded-lg text-muted transition hover:bg-surface hover:text-fg"
        aria-label={t("nav.theme")}
      >
        <Icon name="sun" class="hidden size-4 dark:block" />
        <Icon name="moon" class="size-4 dark:hidden" />
      </button>
      <details id="mobile-menu" class="group md:hidden">
        <summary
          class="grid size-9 cursor-pointer list-none place-items-center rounded-lg text-muted transition hover:bg-surface hover:text-fg [&::-webkit-details-marker]:hidden"
          aria-label={t("nav.menu")}
        >
          <Icon name="menu" class="size-5 group-open:hidden" />
          <Icon name="close" class="hidden size-5 group-open:block" />
        </summary>
        <ul class="absolute inset-x-0 top-full mt-2 grid gap-1 rounded-2xl border border-line/80 bg-bg/95 p-2 shadow-lg backdrop-blur-xl">
          {
            items.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="block rounded-lg px-3 py-3 text-base text-fg transition hover:bg-surface"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
    </div>
  </nav>
</header>

<script>
  const menu = document.getElementById("mobile-menu") as HTMLDetailsElement | null
  menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => (menu.open = false)))
  document.addEventListener("click", (e) => {
    if (menu?.open && !menu.contains(e.target as Node)) menu.open = false
  })

  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const dark = document.documentElement.classList.toggle("dark")
    try {
      localStorage.setItem("theme", dark ? "dark" : "light")
    } catch {}
  })

  const links = document.querySelectorAll<HTMLAnchorElement>("[data-nav]")
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue
        links.forEach((link) =>
          link.toggleAttribute("data-active", link.dataset.nav === entry.target.id),
        )
      }
    },
    { rootMargin: "-45% 0px -50% 0px" },
  )
  document.querySelectorAll("section[id]").forEach((s) => observer.observe(s))
</script>
