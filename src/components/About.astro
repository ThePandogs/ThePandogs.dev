---
import { about, stack } from "@/data/profile"
---

<div class="space-y-5 text-lg leading-relaxed text-muted text-pretty">
  {about.map((paragraph) => <p>{paragraph}</p>)}
</div>

<dl class="mt-12 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2">
  {
    stack.map(({ group, items }) => (
      <div class="bg-bg p-5">
        <dt class="font-mono text-xs uppercase tracking-wider text-accent">{group}</dt>
        <dd class="mt-2 text-sm">{items.join(" · ")}</dd>
      </div>
    ))
  }
</dl>
