---
import { Image } from "astro:assets"
import Icon from "./Icon.astro"
import { clientProjects } from "@/data/profile"

const host = (site: string) => new URL(site).hostname.replace(/^www\./, "")
---

<div class="space-y-16">
  {
    clientProjects.map((project) => (
      <article class="group">
        <a
          href={project.site}
          target="_blank"
          rel="noopener noreferrer"
          class="block overflow-hidden rounded-2xl border border-line bg-surface transition hover:border-fg/25"
          aria-label={`Abrir ${host(project.site)}`}
        >
          <div class="flex items-center gap-2 border-b border-line px-4 py-2.5">
            <span class="flex gap-1.5" aria-hidden="true">
              <span class="size-2.5 rounded-full bg-line" />
              <span class="size-2.5 rounded-full bg-line" />
              <span class="size-2.5 rounded-full bg-line" />
            </span>
            <span class="mx-auto flex items-center gap-1.5 rounded-md bg-bg px-3 py-0.5 font-mono text-xs text-muted">
              <Icon name="lock" class="size-3" />
              {host(project.site)}
            </span>
            <span class="w-[2.625rem]" aria-hidden="true" />
          </div>
          <div class="aspect-[16/10] overflow-hidden">
            <Image
              src={project.image}
              alt={`Página de inicio de ${project.client}`}
              widths={[640, 1024, 1440]}
              sizes="(min-width: 1024px) 760px, 100vw"
              class="size-full object-cover object-top transition duration-700 group-hover:scale-[1.015]"
            />
          </div>
        </a>

        <div class="mt-6 grid gap-6 md:grid-cols-[1fr_16rem]">
          <div>
            <p class="font-mono text-xs uppercase tracking-wider text-accent">{project.client}</p>
            <h3 class="mt-1 text-2xl font-semibold tracking-tight">{project.title}</h3>
            <p class="mt-3 leading-relaxed text-muted text-pretty">{project.description}</p>
            <ul class="mt-4 space-y-2 text-sm text-muted">
              {project.highlights.map((item) => (
                <li class="flex gap-2.5">
                  <Icon name="check" class="mt-0.5 size-4 shrink-0 text-accent" />
                  {item}
                </li>
              ))}
            </ul>
          </div>

          <aside class="flex flex-col gap-4 md:items-start">
            <a
              href={project.site}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 rounded-xl bg-fg px-4 py-2.5 text-sm font-medium text-bg transition hover:opacity-90"
            >
              <Icon name="globe" />
              Ver la web
            </a>
            <ul class="flex flex-wrap gap-2">
              {project.tags.map((tag) => (
                <li class="rounded-md border border-line px-2 py-0.5 font-mono text-xs text-muted">{tag}</li>
              ))}
            </ul>
            <p class="flex items-center gap-1.5 text-xs text-muted">
              <Icon name="lock" class="size-3.5" />
              Proyecto de cliente · código privado
            </p>
          </aside>
        </div>
      </article>
    ))
  }
</div>
