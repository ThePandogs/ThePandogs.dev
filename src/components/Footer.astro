---
import { profile } from "@/data/profile"

const year = new Date().getFullYear()
---

<footer class="border-t border-line py-10 text-sm text-muted">
  <div class="flex flex-col justify-between gap-4 sm:flex-row">
    <p>© {year} {profile.name} · {profile.alias}</p>
    <ul class="flex gap-5">
      <li><a class="hover:text-fg" href={profile.links.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
      <li><a class="hover:text-fg" href={profile.links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
      <li><a class="hover:text-fg" href={`mailto:${profile.email}`}>Email</a></li>
    </ul>
  </div>
</footer>
