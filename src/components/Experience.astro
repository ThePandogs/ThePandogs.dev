---
import Icon from "./Icon.astro"
import { experience } from "@/data/profile"
---

<ol class="divide-y divide-line">
  {
    experience.map((job) => (
      <li class="grid gap-2 py-8 first:pt-0 last:pb-0 sm:grid-cols-[8rem_1fr] sm:gap-6">
        <p class="font-mono text-xs uppercase tracking-wider text-muted sm:pt-1.5">{job.period}</p>
        <div>
          <h3 class="text-lg font-medium">
            {job.role}
            <span class="text-muted"> · </span>
            {job.url ? (
              <a
                href={job.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 text-accent hover:underline"
              >
                {job.company}
                <Icon name="arrow" class="size-3.5" />
              </a>
            ) : (
              <span class="text-accent">{job.company}</span>
            )}
          </h3>
          <p class="mt-2 max-w-2xl leading-relaxed text-muted text-pretty">{job.description}</p>
          <ul class="mt-4 flex flex-wrap gap-2">
            {job.tags.map((tag) => (
              <li class="rounded-md border border-line px-2 py-0.5 font-mono text-xs text-muted">{tag}</li>
            ))}
          </ul>
        </div>
      </li>
    ))
  }
</ol>
