---
import Base from "@/layouts/Base.astro"
import { defaultLang, homePath, useTranslations } from "@/i18n"

const lang = defaultLang
const t = useTranslations(lang)
const en = useTranslations("en")
---

<Base lang={lang} title={t("404.title")} description={t("404.body")} alternates={false}>
  <main class="grid min-h-dvh place-items-center px-6 text-center">
    <div>
      <p class="font-mono text-sm text-accent">404</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight">{t("404.heading")}</h1>
      <p class="mt-3 text-muted">{t("404.body")}</p>
      <p class="mt-1 text-sm text-muted" lang="en">{en("404.body")}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={homePath("es")} class="rounded-xl bg-fg px-5 py-3 text-sm font-medium text-bg">{t("404.back")}</a>
        <a href={homePath("en")} lang="en" class="rounded-xl border border-line px-5 py-3 text-sm">{en("404.back")}</a>
      </div>
    </div>
  </main>
</Base>
